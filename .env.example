ADDON_PORT=7000
TORRSERVER_INTERNAL_URL=http://torrserver:8090
PUBLIC_TORRSERVER_URL=http://192.168.1.50:8090
PUBLIC_ADDON_URL=http://192.168.1.50:7000
ACCESS_TOKEN=replace-with-long-random-token
# Optional: a different long random token for cloud playback redirects.
CLOUD_ACCESS_TOKEN=
CLOUD_HEARTBEAT_URL=
LIBRARY_PATH=/data/library.json
MEDIA_ROOT=/media
UPLOAD_ROOT=/data/media
LOG_LEVEL=info
MEDIA_DIR=/Users/your-name/Downloads
HOME_SPEED_MBPS=10
# Optional: return LAN stream URLs to clients that share this server's
# public IP (useful behind a Cloudflare Tunnel). Set to "off" if your ISP
# uses CGNAT and unrelated households share your public IP.
LAN_REDIRECT=auto
# Optional: Cloudflare Tunnel token for remote access.
# Create a tunnel in the Zero Trust dashboard, then:
#   docker-compose --profile tunnel up -d
TUNNEL_TOKEN=
