# HoshiStream runs natively — no containers. See guides/setup-native-macos.md.

# ---------------------------------------------------------------------------
# Used by the native app (scripts/native-server.mjs and the macOS supervisor)
# ---------------------------------------------------------------------------

ADDON_PORT=7000

# Long random string. Appears in your tokenized add-on URL and guards the
# management API.
ACCESS_TOKEN=replace-with-long-random-token

# Folder the app scans for local media.
MEDIA_DIR=/Users/your-name/Movies

# Where the library, logs, and TorrServer data live.
HOSHISTREAM_STATE_DIR="/Users/your-name/Library/Application Support/HoshiStream"

# Expected sustained LAN speed, used for the direct-play bitrate check. This
# is only the fallback: the app measures the real link speed at startup and
# on demand (Status page / menu bar "Check Speed") via Cloudflare's open
# speed-test endpoint, and the measured value takes precedence.
HOME_SPEED_MBPS=10

# Optional: play on this computer through mpv instead of on a TV client.
# Leave unset to use a bundled or PATH-resolved mpv, or to fall back to the
# system default player. See ADR 0008.
PLAYER_PATH=

# Optional: return LAN stream URLs to clients that share this server's public
# IP (useful behind a Cloudflare Tunnel). Set to "off" if your ISP uses CGNAT
# and unrelated households share your public IP.
LAN_REDIRECT=auto

# Optional: opt-in stream repair (ADR 0010). When enabled, entries whose probe
# verdict predicts a TV playback failure get a second "Compatible" stream that
# remuxes or fixes the audio in real time via the vendored ffmpeg. Direct play
# stays the default; video is never re-encoded by this tier.
TRANSCODE_ENABLED=false
# TRANSCODE_MAX_SESSIONS=2
# Target bitrate (Mbps) for hardware video re-encodes and the lower-bitrate
# rendition offered to remote (tunnel) clients.
# TRANSCODE_VIDEO_BITRATE_MBPS=8

# ---------------------------------------------------------------------------
# Only needed when running the add-on directly (npm start), without the
# supervisor. The native app derives all of these itself and overrides
# whatever is set here.
# ---------------------------------------------------------------------------

# TorrServer runs on this machine.
TORRSERVER_INTERNAL_URL=http://127.0.0.1:8090

# The addresses other devices on your LAN use to reach this machine.
PUBLIC_TORRSERVER_URL=http://192.168.1.50:8090
PUBLIC_ADDON_URL=http://192.168.1.50:7000

# Default to the per-user application data directory when unset:
# ~/Library/Application Support/HoshiStream on macOS,
# %LOCALAPPDATA%\HoshiStream on Windows.
# LIBRARY_PATH=
# MEDIA_ROOT=
# UPLOAD_ROOT=

LOG_LEVEL=info
