{
  "name": "hoshistream-addon",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --env-file=.env src/index.ts",
    "dev:native": "node --watch --watch-path=src --watch-path=../scripts ../scripts/native-server.mjs --dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bencode": "4.0.1",
    "stremio-addon-sdk": "1.6.10",
    "zod": "4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.17.1",
    "eslint": "9.39.2",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.54.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "tmp": "0.2.7"
  }
}
